generator client {
  provider = "prisma-client-js"
}

datasource postgres {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  ADMIN
}

model User {
  id          String   @default(uuid()) @id
  name        String?
  email       String   @unique
  password    String
  role        UserRole @default(STUDENT)
  emailVerified Boolean?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  applications Application[]
  emailVerifications EmailVerification[]
  passwordResetTokens PasswordResetToken[]
}

model ScholarshipProgram {
  id          String   @default(uuid()) @id
  name        String
  description String?
  educationLevels EducationLevel[]
  minimumMarks Decimal?
  minimumCGPA Decimal?
  maximumFamilyIncome Decimal?
  applicationFee Decimal
  applicationDeadline DateTime
  isActive    Boolean  @default(true)
  requiredDocuments DocumentConfig[]  @relation(name: "documents")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  applications Application[]
}

model Criteria {
  educationLevel EducationLevel @id
  minimumMarks     Decimal
  minimumCGPA      Decimal
  familyIncomeMax  Decimal
}

enum EducationLevel {
  HIGH_SCHOOL
  DIPLOMA
  UNDERGRADUATE
  POSTGRADUATE
}

model DocumentConfig {
  id          String   @default(uuid()) @id
  name        String
  description String?
  scholarshipProgram ScholarshipProgram @relation(name: "documents", fields: [scholarshipProgramId], references: [id])
  scholarshipProgramId String
  maxFileSize Int
  allowedTypes String[]
  isRequired   Boolean  @default(true)
}

model Application {
  id               String   @default(uuid()) @id
  applicationId    String   @unique
  status           ApplicationStatus  @default(DRAFT)
  student          User       @relation(fields: [studentId], references: [id])
  studentId        String
  scholarshipProgram ScholarshipProgram @relation(fields: [scholarshipProgramId], references: [id])
  scholarshipProgramId String
  personalDetails  PersonalDetails?
  personalDetailsId String?
  address          Address?
  addressId        String?
  parentGuardian   ParentGuardian?
  parentGuardianId String?
  academicDetails  AcademicDetails?
  academicDetailsId String?
  financialDetails FinancialDetails?
  financialDetailsId String?
  applicationDocuments ApplicationDocument[]
  payments         Payment[]
  receipts         Receipt[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  WAITLISTED
  CORRECTION_REQUESTED
}

model PersonalDetails {
  id              String   @default(uuid()) @id
  application     Application @relation(fields: [applicationId], references: [id])
  applicationId   String  @unique
  fullName        String
  dateOfBirth     DateTime
  gender          String
  phone           String
  idProofNumber   String?
}

model Address {
  id              String   @default(uuid()) @id
  application     Application @relation(fields: [applicationId], references: [id])
  applicationId   String  @unique
  street          String
  city            String
  district        String
  state           String
  pinCode         String
}

model ParentGuardian {
  id              String   @default(uuid()) @id
  application     Application @relation(fields: [applicationId], references: [id])
  applicationId   String  @unique
  guardianName    String
  relationship    String
  occupation      String
  contactNumber   String
  income          Decimal?
}

model AcademicDetails {
  id              String   @default(uuid()) @id
  application     Application @relation(fields: [applicationId], references: [id])
  applicationId   String  @unique
  schoolCollege   String
  course          String
  educationLevel  EducationLevel
  academicYear    String
  yearOfStudy     String
  marksPercentageCGPA String
}

model FinancialDetails {
  id              String   @default(uuid()) @id
  application     Application @relation(fields: [applicationId], references: [id])
  applicationId   String  @unique
  familyIncome    Decimal
  incomeSource    String
}

model ApplicationDocument {
  id              String   @default(uuid()) @id
  application     Application @relation(fields: [applicationId], references: [id])
  applicationId   String
  storageKey      String
  storageProvider  String
  originalFilename String
  fileType        String
  fileSize        Int
  uploadedAt      DateTime @default(now())
  uploadedBy      String
}

model Payment {
  id               String   @default(uuid()) @id
  application      Application @relation(fields: [applicationId], references: [id])
  applicationId    String
  razorpayOrderId   String @unique
  razorpayPaymentId String?
  amount           Decimal
  currency         String   @default("INR")
  status           PaymentStatus  @default(PENDING)
  paymentDate      DateTime?
  createdAt        DateTime @default(now())
}

enum PaymentStatus {
  SUCCESS
  FAILED
  PENDING
  REFUNDED
}

model Receipt {
  id               String   @default(uuid()) @id
  application      Application @relation(fields: [applicationId], references: [id])
  applicationId    String
  receiptKey       String
  trustName        String
  studentName      String
  amount           Decimal
  paymentId        String
  paymentDate      DateTime
  status           String
  generatedAt      DateTime @default(now())
}

model Announcement {
  id          String   @default(uuid()) @id
  title       String
  content     String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy   String?
}

model EmailVerification {
  id              String   @default(uuid()) @id
  user            User     @relation(fields: [userId], references: [id])
  userId          String
  verificationToken String @unique
  expiresAt       DateTime
  used            Boolean  @default(false)
  createdAt       DateTime @default(now())
}

model PasswordResetToken {
  id              String   @default(uuid()) @id
  user            User     @relation(fields: [userId], references: [id])
  userId          String
  resetToken      String @unique
  expiresAt       DateTime
  used            Boolean  @default(false)
  createdAt       DateTime @default(now())
}

model WebhookLog {
  id               String   @default(uuid()) @id
  razorPayEventId String   @unique
  event            String
  applicationId    String?
  processedAt      DateTime @default(now())
  status           String   @default("PROCESSED")
}