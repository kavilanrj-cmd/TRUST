DATABASE_URL="postgresql://neulakannu_user:neulakannu_pass@localhost:5432/neulakannu?schema=public"

# QA TEST MODE (DEFAULT MUST BE false / unset).
# When set to "true", a login with an email that does NOT exist auto-creates an
# isolated STUDENT (applicant) test account instead of returning
# "Invalid email or password". Only affects non-existent emails; existing
# accounts and all privileged roles keep the normal login flow. Never enable in
# production.
ALLOW_TEST_APPLICANT_LOGIN=false

JWT_SECRET="change-this-to-a-very-secure-secret-key"
JWT_REFRESH_SECRET="change-this-to-a-very-secure-refresh-secret"

# Admin session cookie secret (used to sign cookie-parser cookies)
COOKIE_SECRET="change-this-to-a-very-secure-cookie-secret"

RAZORPAY_KEY_ID="rzp_test_your_razorpay_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

R2_ACCOUNT_ID="your_r2_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="your_r2_bucket_name"

RESEND_API_KEY="your_resend_api_key"

NEXT_PUBLIC_API_URL="http://localhost:5000"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_razorpay_key_id"

# Frontend origin that may make authenticated (credentialed) requests to this API
FRONTEND_URL="http://localhost:3000"

# Media storage. Set MEDIA_STORAGE=local (default, stores under UPLOAD_DIR) OR 
# MEDIA_STORAGE=r2 to use Cloudflare R2. For production over HTTPS with
# cross-origin admin cookies, leave NODE_ENV=production.
MEDIA_STORAGE="local"
UPLOAD_DIR="uploads"